<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC 
    "-//Hibernate/Hibernate Configuration DTD 3.0//EN" 
    "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- Configuration de la source de données JDBC (par défaut H2 en mémoire, commutable vers MySQL) -->
        <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <property name="hibernate.dialect">org.hibernate.dialect.MySQL8Dialect</property>
        <property name="hibernate.hbm2ddl.auto">update</property>
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>
        <property name="hibernate.jdbc.batch_size">30</property>

        <!-- Entités métier personnalisées - Auteur : Ali Mahraoui -->
        <mapping class="ma.ali.mahraoui.commerce.entities.Categorie"/>
        <mapping class="ma.ali.mahraoui.commerce.entities.Produit"/>
        <mapping class="ma.ali.mahraoui.commerce.entities.Commande"/>
        <mapping class="ma.ali.mahraoui.commerce.entities.CommandeProduit"/>
        <mapping class="ma.ali.mahraoui.commerce.entities.User"/>
        <mapping class="ma.ali.mahraoui.commerce.entities.Client"/>
        <mapping class="ma.ali.mahraoui.commerce.entities.Fournisseur"/>
    </session-factory>
</hibernate-configuration>
